# ══════════════════════════════════════════════════════════
# PulseGuard AI — Git Ignore Rules
# ══════════════════════════════════════════════════════════

# ── Files exceeding GitHub 100MB limit ────────────────────
# (Restored automatically via restore_sentiment140.py)
data/raw/training.1600000.processed.noemoticon.csv

# ── Heavy GPU Datasets & Deep Learning Models (>1 GB) ─────
data/processed/gpu_datasets/
data/processed/gpu_models/
.cache/

# ── Temporary Archives & Logs ─────────────────────────────
*.zip
*.tar.gz
training_log.txt
training_errors.txt

# ── Python Cache ──────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd

# ── Jupyter Notebook Checkpoints ──────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Virtual Environment ──────────────────────────────────
venv/
.venv/
env/
.env

# ── IDE & OS Files ────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
Thumbs.db
.DS_Store
desktop.ini
